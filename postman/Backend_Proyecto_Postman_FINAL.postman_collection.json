                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Password excluded\", function () { pm.expect(res.password).to.be.undefined; });",
                  "if (res.id) pm.collectionVariables.set('userId', String(res.id));"
                ],
                "type": "text/javascript"
