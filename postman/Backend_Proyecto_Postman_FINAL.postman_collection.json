  "item": [
    {
      "name": "01 - AUTENTICACION",
      "item": [
        {
          "name": "01 - Login ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "const token = data.token || data.accessToken || data.data?.token || data.data?.accessToken;",
                  "if (token) pm.collectionVariables.set('adminToken', token);",
                  "else console.log('No se encontro token: ', data);",
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Inicia sesión con credenciales de administrador y autoguarda el token en adminToken."
          },
          "response": []
        },
        {
