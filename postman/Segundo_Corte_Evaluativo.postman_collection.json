{
  "info": {
    "_postman_id": "c7a8e8e2-9b21-4f11-8c43-f6610022d41b",
    "name": "Segundo Corte Evaluativo - Juliana Gómez Osorio",
    "description": "Colección completa de pruebas para el Segundo Corte Evaluativo de Backend. Incluye CRUD de Usuarios, CRUD de Proyectos, Seguridad JWT, Control de Acceso basado en Roles (RBAC) y scripts automáticos de extracción de token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@ejemplo.com",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "admin1234",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "2",
      "type": "string"
    },
    {
      "key": "projectId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Seguridad (Middlewares)",
      "item": [
        {
          "name": "01. Petición SIN Token (Espera 401 Unauthorized)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            },
            "description": "Demuestra la respuesta 401 cuando no se proporciona cabecera Authorization."
          },
          "response": []
        },
        {
          "name": "02. Petición con Token Inválido (Espera 403 Forbidden)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "token_invalido_o_corrupto_12345",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            },
            "description": "Demuestra la respuesta 403 cuando la firma JWT falla o está expirada."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Autenticación (Auth)",
      "item": [
        {
          "name": "03. Login Admin (Autoguardado de adminToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.token) {",
                  "    pm.collectionVariables.set(\"adminToken\", response.token);",
                  "    console.log(\"Token JWT guardado automáticamente en adminToken\");",
                  "}",
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Token exists in response\", function () {",
                  "    pm.expect(response.token).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Inicia sesión como administrador y almacena automáticamente el JWT generado en la variable adminToken."
          },
          "response": []
        },
        {
          "name": "04. Login Usuario Regular (Autoguardado de userToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.token) {",
                  "    pm.collectionVariables.set(\"userToken\", response.token);",
                  "    console.log(\"Token JWT guardado en userToken\");",
                  "}",
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"carlos@ejemplo.com\",\n  \"password\": \"user1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Inicia sesión con rol 2 (Usuario) para pruebas de autorización y RBAC."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Módulo de Usuarios",
      "item": [
        {
          "name": "05. Crear Usuario Regular (POST /users/create)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Password must NOT be present in response\", function () {",
                  "    pm.expect(response.password).to.be.undefined;",
                  "});",
                  "if (response.id) {",
                  "    pm.collectionVariables.set(\"userId\", String(response.id));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Lopez\",\n  \"email\": \"ana.lopez@ejemplo.com\",\n  \"password\": \"passwordSeguro123\",\n  \"role_id\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/create",
              "host": ["{{baseUrl}}"],
              "path": ["users", "create"]
            },
            "description": "Crea un usuario regular asociado al administrador autenticado."
          },
          "response": []
        },
        {
          "name": "06. Listar Usuarios (GET /users - Sin Contraseña)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Every user must NOT have password field\", function () {",
                  "    response.forEach(u => {",
                  "        pm.expect(u.password).to.be.undefined;",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            },
            "description": "Lista usuarios excluyendo estrictamente el campo password."
          },
          "response": []
        },
        {
          "name": "07. Actualizar Usuario (PUT /users/update/:id)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
