            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/role/2",
              "host": ["{{baseUrl}}"],
              "path": ["users", "role", "2"]
            },
            "description": "Retorna los usuarios que poseen el rol 2 (Usuario regular)."
          },
          "response": []
        },
        {
          "name": "09. Filtrar Usuarios por Email (GET /users?email=...)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users?email=carlos",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [
                {
                  "key": "email",
                  "value": "carlos"
                }
              ]
            },
            "description": "Búsqueda con filtro parcial de correo mediante req.query.email."
          },
          "response": []
        }
      ]
    },
