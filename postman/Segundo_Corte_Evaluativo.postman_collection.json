    {
      "name": "5. Control de Permisos y Roles (RBAC)",
      "item": [
        {
          "name": "19. Usuario Regular Creando Proyecto (Espera 403 Forbidden)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Intento no autorizado\",\n  \"description\": \"Un usuario con role_id: 2 no debe poder crear proyectos\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/projects",
              "host": ["{{baseUrl}}"],
              "path": ["projects"]
            },
            "description": "Comprueba que checkRole([1]) deniega el acceso con 403 a usuarios con rol 2."
          },
          "response": []
        }
      ]
